---
// One spike raster row (DESIGN.md, Drawings: Spike raster): a band with a
// baseline through its middle, year marks, the role's spikes across its dates,
// a marker at the "now" end for the ongoing role, and a label under each end.
// Experience puts one above each entry, all on the same time axis.
//
// The markup and styles draw it at rest: the resting state, the
// reduced-motion state, and, less what the script adds, the state without
// JavaScript. The script sweeps each row once, the first time it is fully in
// view (DESIGN.md, Motion: Experience raster): a playback cursor crosses the
// row, and each spike flashes as the cursor reaches it. The spikes are
// separate elements, left to right, and they rest with fill-opacity, which is
// what the flash changes. The cursor is the script's alone: it is made as a
// sweep starts and removed as it ends, so at rest there is none.
//
// Two layers:
//
//   - The baseline and the two labels, which are plain CSS. They give the row
//     its full height, so the page is the same before the script runs and
//     without JavaScript.
//   - The year marks, spikes, and marker, which the script adds at the row's
//     real width and redraws when that width changes. Spacing is in px, so a
//     narrower row holds fewer spikes, not tighter ones. Where each one goes
//     is worked out in src/lib/raster.ts, which centers every spike and the
//     marker on one of the row's own pixels, so each row is equally sharp on
//     a 1x screen. Their sizes are set in the styles below, and the script
//     only moves each one to its place.
import type { Role } from '../lib/raster.ts';

interface Props extends Role {
  /** The year the shared axis starts in, on January 1. */
  axisStart: number;
  /** The build date, YYYY-MM-DD: the axis's "now" end. */
  now: string;
}

const { start, end, schedule, axisStart, now } = Astro.props;
---

<div
  class="raster"
  data-raster
  data-start={start}
  data-end={end}
  data-schedule={schedule}
  data-axis-start={axisStart}
  data-now={now}
  aria-hidden="true"
>
  <div class="band">
    <svg>
      <g class="ticks"></g>
      <g class="spikes"></g>
      <g class="marker"></g>
    </svg>
  </div>
  {/* "now" is design text, not copy (DESIGN.md). */}
  <div class="labels"><span>{axisStart}</span><span>now</span></div>
</div>

<script>
  import { flasher } from '../lib/flash.ts';
  import { animated, playOnce } from '../lib/play-once.ts';
  import { rasterRow } from '../lib/raster.ts';
  import type { Pattern, Schedule } from '../lib/raster.ts';
  import { arrivals, cursor } from '../lib/sweep.ts';
  import type { SweepTokens } from '../lib/sweep.ts';
  import { tokenReader } from '../lib/tokens.ts';

  // The pattern's numbers, from tokens.css.
  const token = tokenReader();
  const pattern: Pattern = {
    pitch: token('--raster-pitch'),
    burst: {
      'full-time': [token('--raster-ft-burst-min'), token('--raster-ft-burst-max')],
      'part-time': [1, token('--raster-pt-burst-max')],
    },
    gap: {
      'full-time': [token('--raster-ft-gap-min'), token('--raster-ft-gap-max')],
      'part-time': [token('--raster-pt-gap-min'), token('--raster-pt-gap-max')],
    },
  };

  // The sweep's times and easings, from tokens.css.
  const root = getComputedStyle(document.documentElement);
  const times: SweepTokens = {
    sweep: token('--sweep'),
    fade: token('--flash-in'),
    strength: token('--sweep-cursor'),
    rate: root.getPropertyValue('--ease-travel').trim(),
    ease: root.getPropertyValue('--ease-out').trim(),
  };
  const flash = flasher();

  const rect = () => document.createElementNS('http://www.w3.org/2000/svg', 'rect');

  // One mark per position, each a <rect> the styles size and center on its
  // own origin.
  function place(group: Element, positions: number[]) {
    group.replaceChildren(
      ...positions.map((x) => {
        const mark = rect();
        mark.setAttribute('transform', `translate(${x})`);
        return mark;
      }),
    );
  }

  /** Draws a row `width` px wide, and returns where its spikes are. */
  function draw(row: HTMLElement, width: number): number[] {
    const { start = '', end = '', schedule, axisStart, now = '' } = row.dataset;
    const { ticks, spikes, marker } = rasterRow(
      { start, end, schedule: schedule as Schedule },
      { startYear: Number(axisStart), now },
      width,
      pattern,
    );
    place(row.querySelector('.ticks')!, ticks);
    place(row.querySelector('.spikes')!, spikes);
    place(row.querySelector('.marker')!, marker === null ? [] : [marker]);
    return spikes;
  }

  // What each row holds: the width it was last drawn at, and its spikes there.
  const drawn = new WeakMap<Element, { width: number; spikes: number[] }>();

  /**
   * Draws a row at the width it has now, unless that is how it is drawn
   * already, and returns what it holds. Where the row sits on the page doesn't
   * matter: the browser paints an SVG from the screen pixel nearest its
   * corner, so the row's own pixels are the screen's.
   */
  function upToDate(row: HTMLElement) {
    const { width } = row.getBoundingClientRect();
    let holds = drawn.get(row);
    if (holds?.width !== width) {
      holds = { width, spikes: draw(row, width) };
      drawn.set(row, holds);
    }
    return holds;
  }

  /** Starts one row's sweep, and returns its animations. */
  function start(row: HTMLElement): Animation[] {
    // A sweep draws its row first if need be, so it never crosses an empty
    // row or one drawn at another width, whichever observer reports first.
    const { width, spikes } = upToDate(row);

    // The cursor is there only while it sweeps. It goes when its animations
    // end, and when a rest cancels them.
    const line = rect();
    line.classList.add('cursor');
    row.querySelector('svg')!.append(line);
    const { travel, fade } = cursor(times, width);
    const moves = [line.animate(travel.keyframes, travel.timing), line.animate(fade.keyframes, fade.timing)];
    const gone = () => line.remove();
    Promise.all(moves.map((move) => move.finished)).then(gone, gone);

    // Each spike flashes as the cursor's center reaches its own. A redraw
    // mid-sweep replaces the spikes, and the rest that follows it cancels
    // these with the cursor's.
    const marks = [...row.querySelectorAll('.spikes rect')];
    const starts = arrivals(spikes, width, times.sweep);
    return [...moves, ...marks.map((mark, i) => flash(mark, 0, starts[i]))];
  }

  // Draws each row when it is first measured, and again whenever its width
  // changes. Each row sweeps on its own, once.
  const rows = document.querySelectorAll<HTMLElement>('[data-raster]');
  const sizes = new ResizeObserver(() => rows.forEach(upToDate));
  for (const row of rows) {
    sizes.observe(row);
    playOnce(
      row,
      animated(() => start(row)),
    );
  }
</script>

<style>
  .raster {
    color: var(--ink);
    pointer-events: none;
    user-select: none;
  }

  .band {
    position: relative;
    height: var(--raster-band);
  }

  /* The baseline, through the band's middle. */
  .band::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: calc(50% - var(--line) / 2);
    height: var(--line);
    background: currentColor;
    opacity: var(--raster-baseline-op);
  }

  /* As wide as the row, in px, so the script's positions are the row's own.
     The marker is taller than the band, and it and the first year mark are
     centered on the row's two ends. */
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: currentColor;
  }

  /* The script's marks carry no style scope, hence :global. Each is centered
     on the baseline, and on x = 0 before the script moves it. Round ends are
     part of a spike's and the marker's height. */
  .ticks :global(rect) {
    x: calc(var(--line) / -2);
    y: calc((var(--raster-band) - var(--raster-tick)) / 2);
    width: var(--line);
    height: var(--raster-tick);
    opacity: var(--raster-tick-op);
    /* One full pixel column at 1x instead of two half-bright ones, as for the
       axon's line (Axon.astro). */
    shape-rendering: crispEdges;
  }

  /* A spike rests with fill-opacity, a painted property, because that is what
     its flash animates (DESIGN.md, Motion: Brain cells and nuclei). */
  .spikes :global(rect) {
    x: calc(var(--raster-spike-stroke) / -2);
    y: calc((var(--raster-band) - var(--raster-spike)) / 2);
    width: var(--raster-spike-stroke);
    height: var(--raster-spike);
    rx: calc(var(--raster-spike-stroke) / 2);
    fill-opacity: var(--ink-rest);
  }

  .marker :global(rect) {
    x: calc(var(--raster-marker-stroke) / -2);
    y: calc((var(--raster-band) - var(--raster-marker)) / 2);
    width: var(--raster-marker-stroke);
    height: var(--raster-marker);
    rx: calc(var(--raster-marker-stroke) / 2);
  }

  /* The playback cursor, which the script adds for one sweep, over the other
     marks. Its x is its center, which the sweep moves along the row, and it
     shows only as far as the sweep fades it in. */
  svg :global(.cursor) {
    width: var(--line);
    height: var(--raster-band);
    transform: translateX(calc(var(--line) / -2));
    fill-opacity: 0;
  }

  /* Reduced motion switched on mid-sweep leaves the row at rest. The script
     ends the sweep when it hears of the switch, but Chrome tells it a frame
     late, as for the dendrite (Dendrite.astro). For that frame these hold the
     row at rest: an important declaration outranks an animation. */
  @media (prefers-reduced-motion: reduce) {
    svg :global(.cursor) {
      display: none;
    }

    .spikes :global(rect) {
      fill-opacity: var(--ink-rest) !important;
    }
  }

  /* The axis start year at the left end and "now" at the right. */
  .labels {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-3xs);
    color: var(--color-text-muted);
    font-size: var(--step-text-7);
    line-height: var(--leading-label);
  }
</style>
