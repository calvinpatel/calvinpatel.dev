---
// One piece of the About dendrite (DESIGN.md, Drawings: Dendrite): the trunk,
// or the turning point at the top of one story paragraph. About.astro places
// them: the trunk as the story's first child, and each turning point inside
// its paragraph, which is `position: relative`. Every piece is positioned
// from the paragraphs themselves, so the drawing stays with the text when it
// wraps or is enlarged.
//
// The markup and styles draw it fully grown: the resting state, the
// reduced-motion state, and the state without JavaScript. Where the script
// will run and motion is allowed, the styles hide whatever hasn't grown yet,
// from the first paint, and the script grows it one turning point at a time
// (DESIGN.md, Motion: About dendrite).
//
// The trunk is a single piece on purpose. Built as one stretch per paragraph,
// it showed a brighter pixel row where two stretches met, at 1x and 3x.
//
// Each turning point is drawn twice at its real pixel size: in a 40px box for
// the desktop margin, and in a 16px box for the phone's left edge. The path
// data and circle positions below are DESIGN.md's, unchanged.
//
// Beside each turning point is its reach, an empty box over its paragraph
// and the gap below: the length of its stretch of trunk. The script watches
// it to know whether any of the stretch is on screen and whether it has
// changed size.

interface Props {
  /** `'trunk'`, or a paragraph's place in the story, counting from 0. */
  piece: 'trunk' | number;
}

// The five turning points, in story order.
const PARTS = ['soma', 'pruned', 'both-sides', 'two-branches', 'cone'] as const;

const { piece } = Astro.props;
const part = piece === 'trunk' ? undefined : PARTS[piece];

// The trunk spans the story's rows from the first paragraph's down to the top
// of the last one's.
const trunkRows = `1 / span ${PARTS.length - 1}`;
---

{piece === 'trunk' && <span class="trunk" data-dendrite="trunk" style={`grid-row: ${trunkRows}`} aria-hidden="true" />}
{
  part && (
    <span class="turn" data-dendrite="turn" data-part={part} aria-hidden="true">
      {part === 'soma' && (
        <>
          <svg class="wide" width="40" height="48">
            <path class="branch" d="M20 32 Q13 27 7 18 M11 23 L3 24" />
            <circle class="cell" cx="20" cy="12" />
          </svg>
          <svg class="narrow" width="16" height="32">
            <path class="branch" d="M8 22 Q5 18 2 14" />
            <circle class="cell" cx="8" cy="10" />
          </svg>
        </>
      )}
      {part === 'pruned' && (
        <>
          <svg class="wide" width="40" height="48">
            <path class="pruned" d="M20 14 Q11 18 5 29" />
            <circle class="bouton" cx="5" cy="30" r="2" />
          </svg>
          <svg class="narrow" width="16" height="32">
            <path class="pruned" d="M8 12 Q5 15 2 20" />
            <circle class="bouton" cx="1.6" cy="21" r="1.5" />
          </svg>
        </>
      )}
      {part === 'both-sides' && (
        <>
          <svg class="wide" width="40" height="48">
            <path class="branch" d="M20 16 Q12 11 6 3 M10 8 L2 11 M20 26 Q27 22 34 14" />
          </svg>
          <svg class="narrow" width="16" height="32">
            <path class="branch" d="M8 14 Q5 10 2 5 M8 22 Q5 22 2 25" />
          </svg>
        </>
      )}
      {part === 'two-branches' && (
        <>
          <svg class="wide" width="40" height="48">
            <path class="branch" d="M20 14 Q12 10 5 2 M20 24 Q12 27 5 35 M9 30 L3 27" />
          </svg>
          <svg class="narrow" width="16" height="32">
            <path class="branch" d="M8 12 Q5 9 2 5 M8 20 Q5 22 2 26" />
          </svg>
        </>
      )}
      {part === 'cone' && (
        <>
          <svg class="wide" width="40" height="20">
            <path class="prongs" d="M20 4 L13 15 M20 4 L20 17 M20 4 L27 15" />
            <circle cx="13" cy="15.5" r="1.3" />
            <circle cx="20" cy="17.5" r="1.3" />
            <circle cx="27" cy="15.5" r="1.3" />
          </svg>
          <svg class="narrow" width="16" height="16">
            <path class="prongs" d="M8 0 L4 9 M8 0 L8 11 M8 0 L12 9" />
          </svg>
        </>
      )}
    </span>
  )
}
{part && <span class="reach" data-dendrite="reach" data-part={part} aria-hidden="true" />}

<script>
  import { callAbove, growth, longestStroke, stageEnds } from '../lib/dendrite.ts';
  import type { Span } from '../lib/dendrite.ts';
  import { animated, playOnce } from '../lib/play-once.ts';
  import type { Drawing } from '../lib/play-once.ts';
  import { tokenReader } from '../lib/tokens.ts';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  // The growth's times and its easing, from tokens.css.
  const token = tokenReader();
  const plan = growth({
    grow: token('--grow'),
    draw: token('--draw'),
    stagger: token('--grow-stagger'),
    fade: token('--fade'),
  });
  const easing = getComputedStyle(document.documentElement).getPropertyValue('--ease-out').trim();
  // Each part holds its starting look until its turn comes, and leaves the
  // part at rest when it ends.
  const timing = ({ delay, duration }: Span): KeyframeAnimationOptions => ({ delay, duration, easing, fill: 'backwards' });

  // In view means within this many px of it, as in play-once.ts.
  const SLACK = 1;

  /** Marks a turning point, or the trunk, fully grown: the styles stop hiding it. */
  const grown = (part: Element) => part.toggleAttribute('data-grown', true);

  /** A branch drawing from the trunk outward: one dash slid along every stroke. */
  function draw(path: SVGPathElement): Animation {
    const length = longestStroke(path.getAttribute('d')!);
    // The dash's round ends reach half the line's width past it. The dash
    // starts a whole line's width short of its stroke, and the gap after it
    // is as much longer than the stroke, so no end shows before its time.
    const cap = parseFloat(getComputedStyle(path).strokeWidth);
    const dash = `${length} ${length + 2 * cap}`;
    return path.animate(
      [
        { strokeDasharray: dash, strokeDashoffset: length + cap },
        { strokeDasharray: dash, strokeDashoffset: 0 },
      ],
      timing(plan.branch),
    );
  }

  /** A dot appearing, from nothing to its resting strength. */
  function appear(dot: SVGCircleElement): Animation {
    const rest = getComputedStyle(dot).fillOpacity;
    return dot.animate([{ fillOpacity: 0 }, { fillOpacity: rest }], timing(dot.matches('.cell') ? plan.soma : plan.dots));
  }

  function dendrite(trunk: HTMLElement) {
    const turns = [...trunk.parentElement!.querySelectorAll<HTMLElement>('[data-dendrite="turn"]')];
    const paragraphs = turns.map((turn) => turn.parentElement!);
    const reaches = paragraphs.map((paragraph) => paragraph.querySelector<HTMLElement>('[data-dendrite="reach"]')!);
    const last = turns.length - 1;

    // Each turning point: whether its box is fully in view, whether any of
    // its stretch is on screen, and whether its gate's time has passed, which
    // lets the one below start.
    const state = turns.map(() => ({
      inView: false,
      onScreen: false,
      started: false,
      finished: false,
      passed: false,
    }));

    // How many stretches of the trunk show, grown or growing. Where each ends
    // is measured from the paragraphs, so it is measured again when they move.
    let stretches = 0;
    const ends = () =>
      stageEnds(
        trunk.getBoundingClientRect(),
        paragraphs.map((paragraph) => paragraph.getBoundingClientRect().top),
      );
    const showTrunk = (count = stretches) => {
      stretches = Math.max(stretches, count);
      if (stretches > 0) trunk.style.setProperty('--trunk-grown', `${ends()[stretches - 1]}px`);
    };
    const sizes = new ResizeObserver(() => showTrunk());

    /** Leaves a turning point fully grown. False if it already was. */
    const finish = (k: number): boolean => {
      if (state[k].finished) return false;
      state[k].finished = true;
      grown(turns[k]);
      if (k < last) {
        showTrunk(k + 1);
      } else {
        // The whole dendrite is grown, and nothing needs watching any more.
        grown(trunk);
        trunk.style.removeProperty('--trunk-grown');
        watcher?.disconnect();
        sizes.disconnect();
        reduced.removeEventListener('change', still);
      }
      return true;
    };

    // With reduced motion on, now or later, the whole dendrite is grown for
    // good. Switched off again, nothing that was showing may vanish.
    const still = () => {
      if (!reduced.matches) return;
      turns.forEach((_, k) => finish(k));
      settle();
    };

    // The moment a gate's time ran out, on the document's timeline, while the
    // turning point below is told. One that starts then starts from that
    // moment, not from the frame that noticed it, so turning points on screen
    // together start exactly one gate apart.
    let opened: number | null = null;

    /** Starts turning point k growing, and returns its animations. */
    const start = (k: number): Animation[] => {
      // Finished out of sight before it could play: nothing to show.
      if (state[k].finished) return [];
      state[k].started = true;

      // Underneath its animations it is fully grown from now on, so it is
      // left that way when they end or are cancelled.
      const stops = ends();
      const from = k === 0 ? 0 : stops[k - 1];
      grown(turns[k]);
      showTrunk(k + 1);
      const parts = [
        trunk.animate({ '--trunk-grown': [`${from}px`, `${stops[k]}px`] }, timing(plan.stretch)),
        ...[...turns[k].querySelectorAll('path')].map(draw),
        ...[...turns[k].querySelectorAll('circle')].map(appear),
      ];

      // The gate for the one below: a clock with nothing to show. It holds
      // and resumes with the rest, so it counts this one's own play time.
      if (k < last) {
        const clock = turns[k].animate(null, { duration: plan.gate });
        parts.push(clock);
        clock.finished.then(
          () => {
            state[k].passed = true;
            opened = Number(clock.startTime) + plan.gate;
            settle();
            opened = null;
          },
          () => {}, // cancelled: it went straight to rest, which `over` handles
        );
      }
      if (opened !== null) for (const part of parts) part.startTime = opened;

      // Played to the end, or cancelled by a rest. Either way it is grown,
      // and the one below may start. That waits for the next frame: a rest
      // comes from a resize, in the middle of the frame that reports it, when
      // what is in view is not yet known at the new size, and when play-once
      // has yet to hear of the resize for the one below, which it would then
      // send straight to rest too.
      const over = () => {
        if (finish(k)) requestAnimationFrame(settle);
      };
      Promise.all(parts.map((part) => part.finished)).then(over, over);
      return parts;
    };

    // One turning point's drawing, for play-once. `atOnce` is the dendrite's
    // own: it finishes a turning point that is out of sight, which play-once
    // knows nothing of. If play-once was holding it, it learns the drawing is
    // over when it next resumes it.
    const drawings = turns.map((_, k) => {
      const inner = animated(() => start(k));
      let done = () => {};
      const drawing: Drawing & { atOnce(): void } = {
        play(finished) {
          done = finished;
          inner.play(finished);
        },
        hold: inner.hold,
        resume: () => (state[k].finished ? done() : inner.resume()),
        rest: inner.rest,
        atOnce() {
          inner.rest();
          done();
        },
      };
      return drawing;
    });

    // What tells play-once whether each turning point is in view, by the
    // dendrite's rule below.
    const tells: (((inView: boolean) => void) | undefined)[] = [];

    /**
     * Applies the dendrite's rule to the page as it is now. A turning point
     * may grow while its box is fully in view, or one below that is has
     * called on it, once the one above has finished or had its gate's time.
     * Those above that haven't finished come first (callAbove in
     * src/lib/dendrite.ts).
     */
    const settle = () => {
      const call = callAbove(state);
      for (const k of call.finish) if (finish(k)) drawings[k].atOnce();
      state.forEach((turn, k) => {
        const open = k === 0 || state[k - 1].finished || state[k - 1].passed;
        // A finished one only has play-once to tell, so it stops watching.
        tells[k]?.(turn.finished || ((turn.inView || call.grow.includes(k)) && open));
      });
    };

    // One observer for every box and every reach, so each report describes
    // the same moment for all of them. It is made after play-once's own, so
    // by the time it reports, play-once has already held whatever left the
    // screen in the same frame.
    let watcher: IntersectionObserver | undefined;
    const watch = () =>
      new IntersectionObserver(
        (entries) => {
          for (const { target, isIntersecting, intersectionRatio } of entries) {
            const turn = turns.indexOf(target as HTMLElement);
            if (turn !== -1) state[turn].inView = intersectionRatio >= 1;
            else state[reaches.indexOf(target as HTMLElement)].onScreen = isIntersecting;
          }
          settle();
        },
        { rootMargin: `${SLACK}px`, threshold: [0, 1] },
      );

    reduced.addEventListener('change', still);
    still();
    if (state[last].finished) return;

    // The turning points start once the fonts have loaded. Until then the
    // story is set in fallback fonts, and the swap can change the paragraphs'
    // heights, which play-once counts as a resize: it would send a growing
    // turning point straight to fully grown.
    document.fonts.ready.then(() => {
      if (state[last].finished) return;
      turns.forEach((_, k) => {
        // A turning point's box, for play-once, is its reach: it holds while
        // no part of its stretch is on screen, and rests when that changes
        // size.
        playOnce(reaches[k], drawings[k], {
          inView: (_reach, tell) => {
            tells[k] = tell;
            return () => (tells[k] = undefined);
          },
        });
        sizes.observe(reaches[k]);
      });
      watcher = watch();
      for (const part of [...turns, ...reaches]) watcher.observe(part);
    });
  }

  // The styles hide the dendrite only where the browser knows the script will
  // run. One that doesn't know shows it fully grown, and it stays that way.
  if (matchMedia('(scripting: enabled)').matches) {
    for (const trunk of document.querySelectorAll<HTMLElement>('[data-dendrite="trunk"]')) dendrite(trunk);
  }
</script>

<style>
  /* The drawing's geometry, from DESIGN.md's Dendrite section. These belong
     with the path data above rather than in tokens.css. Positions are measured
     from a paragraph's top left corner. */
  .trunk,
  .turn {
    --box-left: calc(-1 * (var(--dendrite-margin) + var(--dendrite-gap))); /* the 40px margin, then the gap */
    --trunk-x: 20px; /* the trunk's center, from the box's left edge */
    --trunk-start: 12px; /* below the first paragraph's top: the soma's center */
    --trunk-end: 6px; /* below the last paragraph's top: the growth cone's tip */
    --cone-drop: 2px; /* the cone's box sits this far below its paragraph's top */

    color: var(--ink);
    pointer-events: none;
  }

  /* The story is a grid with one row per paragraph, and the trunk sits in its
     empty first column, which starts at the paragraphs' left edge. It spans
     the rows down to the top of the last paragraph, and its margins carry it
     from the soma to the cone's tip. */
  .trunk {
    grid-column: 1;
    justify-self: start;
    width: var(--line);
    margin-top: var(--trunk-start);
    margin-bottom: calc(-1 * (var(--story-gap) + var(--trunk-end)));
    margin-left: calc(var(--box-left) + var(--trunk-x) - var(--line) / 2);
    background: currentColor;
    opacity: var(--dendrite-trunk-op);
  }

  .turn {
    position: absolute;
    top: 0;
    left: var(--box-left);
  }

  .turn[data-part='cone'] {
    top: var(--cone-drop);
  }

  svg {
    overflow: visible;
  }

  .narrow {
    display: none;
  }

  path {
    fill: none;
    stroke: currentColor;
    stroke-width: var(--line);
    stroke-linecap: round;
  }

  circle {
    fill: currentColor;
  }

  .branch {
    opacity: var(--dendrite-branch-op);
  }

  .pruned {
    opacity: var(--dendrite-pruned-op);
  }

  .prongs {
    opacity: var(--dendrite-cone-op);
  }

  /* The dots appear with fill-opacity, a painted property (DESIGN.md, Motion:
     Brain cells and nuclei), so the bouton rests with it too. */
  .bouton {
    fill-opacity: var(--ink-rest);
  }

  .cell {
    r: calc(var(--dendrite-soma) / 2);
  }

  .narrow .cell {
    r: calc(var(--dendrite-soma-phone) / 2);
  }

  /* A turning point's stretch of trunk runs through its paragraph and the gap
     below it. The cone's ends inside the last paragraph. Never seen. */
  .reach {
    position: absolute;
    inset: 0 0 calc(-1 * var(--story-gap));
    visibility: hidden;
    pointer-events: none;
  }

  .reach[data-part='cone'] {
    bottom: 0;
  }

  /* How far down the trunk shows, from its top, until it is fully grown. The
     script sets it and grows it; registered so it can be animated as a
     length. */
  @property --trunk-grown {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  /* Before it grows, nothing of the dendrite shows. This holds from the first
     paint, before the script runs, so a page opened at About never shows a
     grown part that then vanishes. Without JavaScript, and with reduced
     motion on, none of it applies and the dendrite is drawn fully grown. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .turn:not([data-grown]) {
      visibility: hidden;
    }

    /* The trunk is one piece, shown through a clip that only its lower edge
       cuts. The other edges stand clear of it: the browser paints a 1px line
       on whole pixels, and a clip at the box's own edges would shave it. Once
       it is fully grown there is no clip at all. */
    .trunk:not([data-grown]) {
      --clear: calc(-1 * var(--line));

      clip-path: inset(var(--clear) var(--clear) calc(100% - var(--trunk-grown)) var(--clear));
    }
  }

  /* Reduced motion switched on mid-growth shows everything fully grown at
     once. The script ends its animations when it hears of the switch, but
     Chrome tells it one frame after the styles above stop applying. For that
     frame these hold every part at rest: an important declaration outranks
     an animation. */
  @media (prefers-reduced-motion: reduce) {
    path {
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
    }

    circle {
      fill-opacity: 1 !important;
    }

    .bouton {
      fill-opacity: var(--ink-rest) !important;
    }
  }

  @media (width < 760px) {
    /* The phone shapes, in the page's left edge. */
    .trunk,
    .turn {
      --box-left: -20px;
      --trunk-x: 8px;
      --trunk-end: 7px;
      --cone-drop: 7px;
    }

    .wide {
      display: none;
    }

    .narrow {
      display: block;
    }
  }
</style>
