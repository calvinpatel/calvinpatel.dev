---
// The shared layout for every page: the head, the skip link, the top bar,
// <main>, and the footer. DESIGN.md's Page head says what the head holds.
import { readFileSync } from 'node:fs';
import { Font } from 'astro:assets';
import { getEntry } from 'astro:content';

import Copy from './Copy.astro';
import Footer from './Footer.astro';
import TopBar from './TopBar.astro';
import { pageUrl } from '../lib/address.ts';
import { copyText } from '../lib/copy.ts';
import { pngSize } from '../lib/png.ts';
import { tokenDeclared } from '../lib/tokens.ts';
import '../styles/global.css';
import tokens from '../styles/tokens.css?raw';

interface Props {
  title: string;
  description: string;
  /** The home page: section links stay on the page and the mark goes to its top. */
  home?: boolean;
  /**
   * The 404 page: search engines leave it out, and it stands in for any
   * address, so it has no canonical URL and no link preview.
   */
  notFound?: boolean;
}

const { title, description, home = false, notFound = false } = Astro.props;
const site = (await getEntry('site', 'site'))!.data;

// The page's one address, as the site serves it (src/lib/address.ts).
const url = pageUrl(Astro.url.pathname, Astro.site);

// The link preview picture. Its size is read from the file, so the tags
// can't say anything else.
const PREVIEW = 'link-preview.png';
const preview = {
  url: new URL(`/${PREVIEW}`, Astro.site).href,
  alt: copyText(site.linkPreview.alt),
  ...pngSize(readFileSync(`public/${PREVIEW}`)),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      notFound ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={url} />
          <meta property="og:type" content="website" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={url} />
          <meta property="og:image" content={preview.url} />
          <meta property="og:image:width" content={preview.width} />
          <meta property="og:image:height" content={preview.height} />
          <meta property="og:image:alt" content={preview.alt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={preview.url} />
          <meta name="twitter:image:alt" content={preview.alt} />
        </>
      )
    }
    {/* The site is dark only. A meta tag can't read a custom property, so
        both values are read from tokens.css as it is written: the page's
        background, and the color scheme it declares. */}
    <meta name="theme-color" content={tokenDeclared(tokens, '--color-bg')} />
    <meta name="color-scheme" content={tokenDeclared(tokens, 'color-scheme')} />
    {/* The favicon (DESIGN.md, Page head): the .ico for browsers that read
        nothing else, the SVG for the rest, and a 180px icon for a phone's
        home screen. `sizes` on the .ico is what lets a browser prefer the SVG. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-plex" preload={[{ weight: 400, style: 'normal' }]} />
    {/* Smooth scrolling to a section starts only after the page has loaded and
        gone to wherever its address points (global.css). */}
    <script is:inline>
      addEventListener('load', () => requestAnimationFrame(() => document.documentElement.classList.add('is-loaded')));
    </script>
  </head>
  <body>
    {/* The skip link (DESIGN.md, Accessibility): the first link on every page,
        shown only while it has focus. Its target is the page's h1, which
        carries id="content" and takes focus (global.css). */}
    <a class="skip" href="#content"><Copy text={site.skipLabel} /></a>
    {/* The home page's neuron canvas sits behind the top bar and the hero.
        It is measured from the page's top, so body and main stay
        unpositioned and without a background (NeuronLayer.astro). */}
    <TopBar home={home} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* At the top left, where the CP mark sits, and over it: the mark's box is
     positioned, so the link needs a z-index to lie on top. It is a top bar
     link's size on the page's own background, underlined as any link. The
     page stays unpositioned, so this is measured from the page's top left
     corner (NeuronLayer.astro has why). */
  .skip {
    position: absolute;
    top: var(--space-2xs);
    left: var(--gutter);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    background: var(--color-bg);
    font-size: var(--step-text-5);
    line-height: var(--leading-snug);
  }

  /* Until it has focus it is read by screen readers and not shown:
     global.css's .visually-hidden, applied here because it depends on focus. */
  .skip:not(:focus) {
    width: 1px;
    height: 1px;
    min-height: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
