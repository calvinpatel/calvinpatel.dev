---
// The shared layout for every page: the top bar, <main>, and the footer.
import { Font } from 'astro:assets';

import Footer from './Footer.astro';
import TopBar from './TopBar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** The home page: section links stay on the page and the mark goes to its top. */
  home?: boolean;
}

const { title, description, home = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-plex" preload={[{ weight: 400, style: 'normal' }]} />
  </head>
  <body>
    <TopBar home={home} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
