---
// The hero: the name and the two hero sentences, middle left, beside the
// brain navigation, over the neuron layer.
import { getEntry } from 'astro:content';

import Brain from './Brain.astro';
import Copy from './Copy.astro';
import NeuronLayer from './NeuronLayer.astro';

const hero = (await getEntry('hero', 'hero'))!.data;
---

<section class="hero">
  {/* The neuron canvas reaches behind the top bar too, which it can only
      while neither this section nor anything above it is positioned
      (NeuronLayer.astro). */}
  <NeuronLayer />
  <div class="container grid">
    {/* The brain's labels keep clear of this text (Brain.astro's script). */}
    <div class="text" data-brain-clear>
      <h1><Copy text={hero.name} /></h1>
      <p>
        {
          hero.lines.map((line) => (
            <span>
              <Copy text={line} />
            </span>
          ))
        }
      </p>
    </div>
    <Brain />
  </div>
</section>

<style>
  /* With the top bar above it, the hero fills the first screen. It stays
     unpositioned: the neuron canvas is measured from the page's top. */
  .hero {
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--top-bar-height));
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(min(var(--hero-text-min), 100%), 1fr) minmax(0, var(--hero-brain));
    align-items: center;
    gap: var(--space-l);
    padding-block: var(--space-l);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    min-width: 0;
  }

  h1 {
    font-size: var(--step-display-1);
    line-height: var(--leading-none);
  }

  p {
    color: var(--color-text-secondary);
    font-size: var(--step-text-2);
    line-height: var(--leading-snug);
  }

  /* Each sentence starts its own line. */
  span {
    display: block;
    text-wrap: balance;
  }

  @media (width < 760px) {
    /* The text, then the brain: one group, centered in the first screen. The
       column is as tall as the hero, and the brain takes what the text leaves
       of it, up to its full size (Brain.astro). The room left over goes above
       the text and below the brain. The column is a container so the brain
       can measure the content width. */
    .hero {
      align-items: stretch;
    }

    .grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      container-type: inline-size;
    }

    .text {
      flex: none;
      margin-top: auto;
    }
  }
</style>
