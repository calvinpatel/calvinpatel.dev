---
// One home-page section: its heading from site.md, and then its content. The
// id the top bar and brain links point at is on the heading, which can take
// focus, so following a link moves focus there (DESIGN.md, Accessibility).
import Copy from './Copy.astro';

interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<section aria-labelledby={id}>
  <div class="container">
    <h2 id={id} tabindex="-1"><Copy text={label} /></h2>
    <slot />
  </div>
</section>

<style>
  section {
    /* The heading to the content. Named so that content which sits closer to
       the heading (Skills' hint) can say how much closer. */
    --section-heading-gap: var(--space-l);

    padding-block: var(--space-section);
  }

  h2 {
    margin-bottom: var(--section-heading-gap);
    font-size: var(--step-display-3);
    line-height: var(--leading-display);
    /* A link to this section points at the heading. The page still lands on
       the section's top edge: this is the section's top padding. */
    scroll-margin-top: var(--space-section);
    /* It takes focus so a screen reader follows the link. It isn't a control,
       so it shows no ring (DESIGN.md, Accessibility). */
    outline: none;
  }
</style>
