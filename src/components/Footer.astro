---
// The footer: the neuron credit line with its Credits link, and the copyright.
import { getEntry } from 'astro:content';

import Copy from './Copy.astro';

const { footer } = (await getEntry('site', 'site'))!.data;

// On the Credits page the link leads to the page it is on, and tells a
// screen reader so (DESIGN.md, Components: Footer).
const onCredits = Astro.url.pathname.replace(/\/$/, '') === '/credits';
---

<footer>
  <div class="container">
    <div class="row">
      <p>
        <span class="credit"><Copy text={footer.credit} /></span>{' '}<a href="/credits" aria-current={onCredits ? 'page' : undefined}><Copy text={footer.creditsLabel} /></a>
      </p>
      <p><Copy text={footer.copyright} /></p>
    </div>
  </div>
</footer>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
    border-top: var(--line) solid var(--color-hairline);
    padding-block: var(--space-s) var(--space-l);
    color: var(--color-text-muted);
    font-size: var(--step-text-7);
    line-height: var(--leading-label);
  }

  /* Room after the sentence, so the Credits link's focus ring clears its full
     stop. On the sentence, not the link: where the link starts a line of its
     own, the room stays at the end of the line above. */
  .credit {
    margin-inline-end: var(--space-3xs);
  }

  @media (width < 760px) {
    .row {
      flex-direction: column;
      gap: var(--space-2xs);
    }
  }
</style>
