---
// A case study page, one per file in src/content/case-studies/, at
// /projects/<project id>. Its title, status, and links come from the project
// it names.
import { getCollection, getEntry } from 'astro:content';

import CaseStudy from '../../components/CaseStudy.astro';
import Layout from '../../components/Layout.astro';
import { copyText } from '../../lib/copy.ts';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return Promise.all(
    studies.map(async (study) => ({
      params: { id: study.data.project },
      props: { study: study.data, project: (await getEntry('projects', study.data.project))!.data },
    })),
  );
}

const { study, project } = Astro.props;
const hero = (await getEntry('hero', 'hero'))!.data;
---

<Layout title={`${copyText(project.name)} – ${copyText(hero.name)}`} description={copyText(study.lede)}>
  <CaseStudy study={study} project={project} />
</Layout>
